# ===================================
# BI 低代码平台服务端 - 环境变量示例
# ===================================
# 复制此文件为 .env 并修改对应的值

# 服务配置
PORT=3000
NODE_ENV=development

# 数据库配置 (MySQL)
# 格式: mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL="mysql://root:your_password@localhost:3306/bi_lowcode"

# JWT 配置
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# 跨域配置
CORS_ORIGIN="http://localhost:5173"

# 数据源密码加密密钥 (AES-256-GCM, 64 字符 hex 字符串)
CRYPTO_KEY="your-64-char-hex-key-for-aes-256-encryption"

# 日志级别
LOG_LEVEL="debug"